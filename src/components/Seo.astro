---
import { club, site } from '../config';
import type { JsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: JsonLd[];
  type?: 'website' | 'article';
}

const { title, description, noindex = false, jsonLd = [], type = 'website' } = Astro.props;
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(chemin || '/', site.url).href;
const image = new URL(site.imagePartage, site.url).href;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={club.nom} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${club.nom}, ${club.promesse}`} />
<meta name="twitter:card" content="summary_large_image" />

{jsonLd.map((donnees) => <script type="application/ld+json" set:html={JSON.stringify(donnees)} />)}
