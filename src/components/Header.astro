---
import { club } from '../config';
import Embleme from './Embleme.astro';

const liensAccueil = [
  { href: '/#club', libelle: 'Le club' },
  { href: '/#tarifs', libelle: 'Tarifs et horaires' },
  { href: '/#activites', libelle: 'Activités' },
  { href: '/#acces', libelle: 'Accès' },
  { href: '/#faq', libelle: 'FAQ' },
];
---

<header class="bloc entete">
  <a class="marque" href="/" aria-label={`${club.nom}, accueil`}>
    <Embleme />
    <span class="marque-nom">{club.nom}</span>
  </a>
  <nav aria-label="Navigation principale">
    <ul>
      {liensAccueil.map((l) => <li><a href={l.href}>{l.libelle}</a></li>)}
    </ul>
  </nav>
  <a class="entete-cta" href="/#fondateur">Carte fondateur</a>
</header>
