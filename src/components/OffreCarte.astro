---
import { carte, club, economieCarte, euros, prixPartieCarte, valeurCarte } from '../config';
import CtaCarte from './CtaCarte.astro';
import CtaWhatsApp from './CtaWhatsApp.astro';
import Info from './Info.astro';

interface Props {
  titre: string;
}

const { titre } = Astro.props;
const c = carte;
const prix = euros(club.tarif.prixParJoueur);
---

<section id="carte" class="offre" aria-labelledby="titre-carte">
  <div class="bloc offre-grille">
    <div class="offre-texte">
      <h2 id="titre-carte">{titre}</h2>
      <slot />
    </div>

    <div class="offre-detail">
      {/* La carte posée à plat : ses champs, en clair. */}
      <div class="carte-plate">
        <h3 class="visuellement-cache">Ce que comprend la carte</h3>
        <dl>
          <div class="champ-prix">
            <dt>Prix de la carte</dt>
            <dd><strong>{euros(c.prix)}</strong> <span>{c.accroche}</span></dd>
          </div>
          <div>
            <dt>Parties</dt>
            <dd>
              <strong>{c.parties}</strong>
              <span>Une partie : un créneau de {club.tarif.dureeCreneauMinutes} minutes, pour un joueur</span>
            </dd>
          </div>
          <div class="champ-demi">
            <dt>La partie</dt>
            <dd><strong>{euros(prixPartieCarte())}</strong> <span>au lieu de {prix}</span></dd>
          </div>
          <div class="champ-demi">
            <dt>Économie</dt>
            <dd><strong>{euros(economieCarte())}</strong> <span>{euros(valeurCarte())} de jeu pour {euros(c.prix)}</span></dd>
          </div>
          <div>
            <dt>Validité</dt>
            <dd><Info valeur={c.validite} /></dd>
          </div>
        </dl>
      </div>
      <p class="offre-vente">En vente jusqu'à {c.venteJusqua}.</p>
      <div class="actions">
        <CtaCarte />
        <CtaWhatsApp contexte="carte" />
      </div>
    </div>
  </div>
</section>

<style>
  .offre {
    background: var(--foret-2);
  }

  .offre-grille {
    display: grid;
    gap: 2.5rem;
  }

  .offre-texte :global(p) {
    color: var(--mousse);
    font-size: 1.1rem;
  }

  /* Carte à plat : coins ISO, champs étiquetés */
  .carte-plate {
    background: var(--foret-3);
    border-radius: var(--rayon-carte);
    padding: 0.5rem 1.4rem 1.4rem;
    margin-bottom: 1.25rem;
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  dl > div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--filet);
    grid-column: 1 / -1;
  }

  /* Prix de la partie et économie côte à côte */
  dl > .champ-demi {
    grid-column: auto;
  }

  dl > .champ-demi + .champ-demi {
    padding-left: 1rem;
    border-left: 1px solid var(--filet);
  }

  dd {
    margin: 0.3rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.85rem;
    font-weight: 600;
    line-height: 1.35;
  }

  dd strong {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 3rem;
    line-height: 0.9;
    color: var(--orange);
    font-variant-numeric: tabular-nums;
  }

  dd span {
    flex: 1 1 9rem;
    font-weight: 500;
    color: var(--mousse);
  }

  .champ-prix dd strong {
    font-size: clamp(5rem, 22vw, 7rem);
    line-height: 0.82;
  }

  .champ-prix dd span {
    color: var(--craie);
    font-weight: 600;
  }

  .offre-vente {
    font-size: 0.95rem;
    color: var(--mousse);
    margin-bottom: 1.5rem;
  }

  .offre :global(.cta-whatsapp) {
    margin-top: 0.75rem;
  }

  @media (min-width: 40rem) {
    .carte-plate {
      padding: 0.75rem 2rem 2rem;
    }
  }

  @media (min-width: 60rem) {
    .offre-grille {
      grid-template-columns: 0.9fr 1.1fr;
      column-gap: 5rem;
      align-items: start;
    }
  }
</style>
