---
import { club, estTodo, plageTexte, regleTexte } from '../config';
import Info from './Info.astro';

const plages = [club.horaires.hiver, club.horaires.ete];
const b = club.bascule;
---

<div class="horaires">
  <dl>
    {
      plages.map((p) => (
        <div>
          <dt>Horaires {p.libelle.toLowerCase()}</dt>
          <dd>{plageTexte(p)}</dd>
        </div>
      ))
    }
  </dl>
  <p class="jours">Ouvert 7 jours sur 7.</p>
  {
    estTodo(b) ? (
      <p><Info valeur={b} /></p>
    ) : (
      <p>
        Horaires d'été à partir du {regleTexte(b.debutEte)}. Horaires d'hiver à partir du {regleTexte(b.debutHiver)}.
      </p>
    )
  }
</div>

<style>
  .horaires {
    border: 1px solid var(--filet);
    border-radius: var(--rayon-carte);
    padding: 0.5rem 1.5rem 1rem;
    align-self: start;
  }

  dl {
    margin: 0 0 0.75rem;
  }

  dl > div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--filet);
  }

  dd {
    margin: 0.25rem 0 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 10vw, 3.2rem);
    line-height: 1;
    color: var(--orange);
    font-variant-numeric: tabular-nums;
  }

  p {
    font-size: 0.95rem;
    color: var(--mousse);
    margin-bottom: 0.5rem;
  }

  .jours {
    color: var(--craie);
    font-weight: 600;
  }

  @media (min-width: 40rem) {
    .horaires {
      padding: 0.75rem 2rem 1.25rem;
    }
  }
</style>
