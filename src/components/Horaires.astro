---
import { club, estTodo, plageTexte, regleTexte } from '../config';
import Info from './Info.astro';

const plages = [club.horaires.hiver, club.horaires.ete];
const b = club.bascule;
---

<div class="horaires">
  <h3>Horaires</h3>
  <ul>
    {plages.map((p) => <li>{p.libelle} : {plageTexte(p)}, 7 jours sur 7</li>)}
  </ul>
  {
    estTodo(b) ? (
      <p><Info valeur={b} /></p>
    ) : (
      <p>
        Horaires d'été à partir du {regleTexte(b.debutEte)}. Horaires d'hiver à partir du {regleTexte(b.debutHiver)}.
      </p>
    )
  }
</div>
