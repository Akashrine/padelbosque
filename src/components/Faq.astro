---
import { getCollection, render } from 'astro:content';
import type { pagesFaq } from '../content.config';
import { faqPage } from '../lib/jsonld';
import { remplir, texteSimple } from '../lib/gabarit';

interface Props {
  page: (typeof pagesFaq)[number];
  titre?: string;
  /** Section claire (verso de la carte). */
  verso?: boolean;
}

const { page, titre = 'Questions fréquentes', verso = false } = Astro.props;
const entrees = (await getCollection('faq', (e) => e.data.page === page)).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const questions = await Promise.all(
  entrees.map(async (e) => ({
    question: remplir(e.data.question),
    reponse: texteSimple(e.body ?? ''),
    Contenu: (await render(e)).Content,
  })),
);
const jsonLd = faqPage(questions);
---

<section id="faq" class:list={{ verso }} aria-labelledby="titre-faq">
  <div class="bloc faq-bloc">
  <h2 id="titre-faq">{titre}</h2>
  <div class="faq-liste">
  {
    questions.map(({ question, Contenu }) => (
      <details>
        <summary>{question}</summary>
        <Contenu />
      </details>
    ))
  }
  </div>
  </div>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</section>

<style>
  @media (min-width: 56rem) {
    .faq-bloc {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      column-gap: 3rem;
      align-items: start;
    }
  }
</style>
