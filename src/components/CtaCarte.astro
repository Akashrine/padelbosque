---
/** Bouton orange vers l'application du club : achat de la carte (par défaut) ou réservation. */
import { application } from '../config';

interface Props {
  libelle?: string;
  note?: string;
}

const { libelle = 'Je prends ma carte', note = `Achat dans l'application ${application.nom}, sur iPhone et Android.` } =
  Astro.props;
---

<p class="cta cta-carte">
  <a href={application.lien}>{libelle}</a>
</p>
<p class="cta-conditions">{note}</p>
