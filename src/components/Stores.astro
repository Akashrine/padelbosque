---
/** Les deux liens directs vers les stores. Le lien unique /app choisit tout seul selon l'appareil. */
import { application } from '../config';
---

<ul class="stores">
  <li class="cta cta-store"><a href={application.appStore} rel="noopener">iPhone : App Store</a></li>
  <li class="cta cta-store"><a href={application.googlePlay} rel="noopener">Android : Google Play</a></li>
</ul>

<style>
  .stores {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 26rem;
  }

  .stores li {
    margin: 0;
  }

  .cta-store a {
    width: 100%;
    background: var(--craie);
    color: var(--foret);
  }

  .cta-store a:hover {
    background: var(--orange);
  }
</style>
