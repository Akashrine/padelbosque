---
import BaseLayout from '../layouts/BaseLayout.astro';
import Info from '../components/Info.astro';
import { adresseTexte, club, legal } from '../config';
import { pageSysteme } from '../lib/pages';

const page = await pageSysteme('mentions-legales');
---

<BaseLayout title={page.title} description={page.description} noindex={page.noindex}>
  <article>
    <h1>{page.h1}</h1>

    <h2>Éditeur du site</h2>
    <dl>
      <dt>Nom commercial</dt>
      <dd>{club.nom}</dd>
      <dt>Raison sociale</dt>
      <dd><Info valeur={legal.raisonSociale} /></dd>
      <dt>Forme juridique et capital</dt>
      <dd><Info valeur={legal.formeJuridique} /></dd>
      <dt>SIRET</dt>
      <dd><Info valeur={legal.siret} /></dd>
      <dt>TVA intracommunautaire</dt>
      <dd><Info valeur={legal.tva} /></dd>
      <dt>Siège social</dt>
      <dd><Info valeur={legal.siege} /></dd>
      <dt>Adresse du club</dt>
      <dd>{adresseTexte()}</dd>
      <dt>Téléphone</dt>
      <dd>{club.telephone.affichage}</dd>
      <dt>Email</dt>
      <dd>{club.email}</dd>
      <dt>Directeur de la publication</dt>
      <dd><Info valeur={legal.directeurPublication} /></dd>
    </dl>

    <h2>Hébergeur</h2>
    <dl>
      <dt>Nom</dt>
      <dd><Info valeur={legal.hebergeur.nom} /></dd>
      <dt>Adresse</dt>
      <dd><Info valeur={legal.hebergeur.adresse} /></dd>
    </dl>

    <page.Contenu />
  </article>
</BaseLayout>
