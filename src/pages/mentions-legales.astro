---
import BaseLayout from '../layouts/BaseLayout.astro';
import Info from '../components/Info.astro';
import Societe from '../components/Societe.astro';
import { adresseTexte, club, legal } from '../config';
import { pageSysteme } from '../lib/pages';

const page = await pageSysteme('mentions-legales');
---

<BaseLayout title={page.title} description={page.description} noindex={page.noindex}>
  <article class="bloc">
    <h1>{page.h1}</h1>

    <h2>Éditeur du site</h2>
    <dl>
      <Societe />
      <dt>Adresse du club</dt>
      <dd>{adresseTexte()}</dd>
      <dt>Téléphone</dt>
      <dd>{club.telephone.affichage}</dd>
      <dt>Email</dt>
      <dd>{club.email}</dd>
      <dt>Directrice de la publication</dt>
      <dd><Info valeur={legal.directeurPublication} /></dd>
    </dl>

    <h2>Hébergeur</h2>
    <dl>
      <dt>Nom</dt>
      <dd><Info valeur={legal.hebergeur.nom} /></dd>
      <dt>Adresse</dt>
      <dd><Info valeur={legal.hebergeur.adresse} /></dd>
    </dl>

    <h2>Réalisation du site</h2>
    <p>Site conçu et développé par <a href={legal.realisation.url} rel="noopener">{legal.realisation.nom}</a>.</p>

    <page.Contenu />
  </article>
</BaseLayout>
