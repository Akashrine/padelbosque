{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    {
      "source": "/app",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }],
      "destination": "https://apps.apple.com/fr/app/padelbosque/id6827471140",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "destination": "https://play.google.com/store/apps/details?id=com.livexperience.padelbosque",
      "permanent": false
    },
    { "source": "/conditions-carte", "destination": "/#carte", "permanent": true },
    { "source": "/bienvenue-carte", "destination": "/app", "permanent": true }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
